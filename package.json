{
  "name": "@thrasherflu/modsent",
  "version": "3.0.1",
  "description": "Dependency-free Turkish/English profanity, link and invite filter for Discord.js, grammY and Telegraf, with bypass detection.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./discordjs": {
      "import": {
        "types": "./dist/discordjs.d.ts",
        "default": "./dist/discordjs.js"
      },
      "require": {
        "types": "./dist/discordjs.d.cts",
        "default": "./dist/discordjs.cjs"
      }
    },
    "./grammy": {
      "import": {
        "types": "./dist/grammy.d.ts",
        "default": "./dist/grammy.js"
      },
      "require": {
        "types": "./dist/grammy.d.cts",
        "default": "./dist/grammy.cjs"
      }
    },
    "./telegraf": {
      "import": {
        "types": "./dist/telegraf.d.ts",
        "default": "./dist/telegraf.js"
      },
      "require": {
        "types": "./dist/telegraf.d.cts",
        "default": "./dist/telegraf.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "changelog.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "profanity-filter",
    "bad-words",
    "turkish-profanity",
    "turkish",
    "english",
    "kufur-filtresi",
    "discord-moderation",
    "telegram-moderation",
    "discordjs",
    "grammy",
    "telegraf",
    "invite-filter",
    "link-filter",
    "content-moderation",
    "text-filter"
  ],
  "author": "Thrasher",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thrashxr/modsent.git"
  },
  "homepage": "https://github.com/thrashxr/modsent#readme",
  "bugs": {
    "url": "https://github.com/thrashxr/modsent/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^10.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
